# OnAir headless server as a systemd service (docs/headless-server.md).
#   sudo useradd --system --home /var/lib/onair --create-home --groups plugdev onair      (plugdev: access to the USB radios; install the udev rules of your radio)
#   (the .deb installs /usr/bin/onair-server and this unit in /usr/lib/systemd/system, disabled; from the portable package:
#    sudo cp bin/onair-server /usr/local/bin/ && sudo cp onair-server.service /etc/systemd/system/ and set ExecStart to /usr/local/bin/onair-server)
#   sudo -u onair onair-server --config /var/lib/onair/server.conf --lan --new-token       (once: makes the settings file and prints the access token)
#   sudo systemctl enable --now onair-server
[Unit]
Description=OnAir headless server (software radio controlled from a web browser)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onair
Group=plugdev
ExecStart=/usr/bin/onair-server --config /var/lib/onair/server.conf
Restart=on-failure
RestartSec=5
StateDirectory=onair
StateDirectoryMode=0750
# the radio needs the USB bus; everything else is closed
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
# a Raspberry Pi 4 or better; the receiver's threads should not be starved by other work
Nice=-5

[Install]
WantedBy=multi-user.target
